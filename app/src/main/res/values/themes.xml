<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.JetpackCompose" parent="android:Theme.Material.Light.NoActionBar" />
    <style name ="Theme.transparent" parent="android:Theme.Material.Light.NoActionBar">
        <item  name="android:windowBackground">@android:color/transparent</item>>
        <item name="android:windowDisablePreview">true</item>>
    </style>


    <!--- Splash API-->

    <style name="Theme.MySPlashScreen" parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">@android:color/white</item>>
        <item name="windowSplashScreenAnimatedIcon">@drawable/love</item>
        <item name="postSplashScreenTheme">@style/Theme.JetpackCompose</item>>
    </style>>



</resources>